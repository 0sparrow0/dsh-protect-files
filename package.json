{
  "name": "dsh-protect-files",
  "version": "0.1.1",
  "type": "module",
  "description": "Protects production configuration files and folders from agent tool access.",
  "license": "MIT",
  "author": "0sparrow0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0sparrow0/dsh-protect-files.git"
  },
  "homepage": "https://github.com/0sparrow0/dsh-protect-files#readme",
  "bugs": {
    "url": "https://github.com/0sparrow0/dsh-protect-files/issues"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "security",
    "protect-files",
    "secret-guard"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "PUBLISHING.md",
    "LISTING.md",
    "LICENSE",
    "market"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-plugin-manager"]
    }
  }
}
